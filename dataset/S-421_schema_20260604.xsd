<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:S100="http://www.iho.int/s100gml/5.0" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns="http://www.iec.ch/S421/2.0" targetNamespace="http://www.iec.ch/S421/2.0" elementFormDefault="qualified" version="2.0.0">
	<!-- ========================================================================================== -->
	<!-- S100 XML/GML Schema for S421                                                               -->
	<!-- ========================================================================================== -->
	<xs:annotation>
		<xs:documentation>Application schema for S421 dataset</xs:documentation>
	</xs:annotation>
	<!-- ========================================================================================== -->
	<!-- Import XSD for reference (s100gmlbase.xsd, S100_gmlProfile.xsd, S100_gmlProfileLevels.xsd) -->
	<!-- ========================================================================================== -->
<xs:import namespace="http://www.opengis.net/gml/3.2" schemaLocation="S100_gmlProfile.xsd"/>
<xs:import namespace="http://www.iho.int/s100gml/5.0" schemaLocation="s100gmlbase.xsd"/>
	<!-- ========================================================================================== -->
	<!-- common types - consider defining a common                                                  -->
	<!-- ========================================================================================== -->
	<xs:complexType name="S100_TruncatedDate">
		<xs:annotation>
			<xs:documentation>built in date types from W3C XML schema, implementing S-100 truncated date</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="gDay" type="xs:gDay"/>
			<xs:element name="gMonth" type="xs:gMonth"/>
			<xs:element name="gYear" type="xs:gYear"/>
			<xs:element name="gMonthDay" type="xs:gMonthDay"/>
			<xs:element name="gYearMonth" type="xs:gYearMonth"/>
			<xs:element name="date" type="xs:date"/>
		</xs:choice>
	</xs:complexType>
	<xs:simpleType name="ISO639-3">
		<xs:annotation>
			<xs:documentation>stub for ISO 639-3 language codes</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="\w{3}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ISO639-2">
		<xs:annotation>
			<xs:documentation>stub for ISO 639-2 language codes</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="\w{3}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ISO3166-alpha2">
		<xs:annotation>
			<xs:documentation>stub for ISO 3166 alpha2 country codes</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="\w{2}"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- ========================================================================================== -->
	<!-- types and elements for the simple attribute types definition                               -->
	<!-- ========================================================================================== -->
	<!-- ========================================================================================== -->
	<!-- Enumeration                                                                                -->
	<!-- ========================================================================================== -->
	<xs:simpleType name="routeInfoStatusType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Initial">
				<xs:annotation>
					<xs:documentation>Initial route or a reference route if meant for more than one specific route plan</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Planned">
				<xs:annotation>
					<xs:documentation>Route and schedule prepared by crew </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Recommended">
				<xs:annotation>
					<xs:documentation>Route and schedule recommended by 3rd party service provider </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Checked">
				<xs:annotation>
					<xs:documentation>Checked route from any 3rd party service provider </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Used for Monitoring">
				<xs:annotation>
					<xs:documentation>Loaded for monitoring</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Terminated">
				<xs:annotation>
					<xs:documentation>Route completed or cancelled</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Errors">
				<xs:annotation>
					<xs:documentation>The received route information is invalid according to schema validation or application level context check</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Incomplete">
				<xs:annotation>
					<xs:documentation>Some fields of received route information are missing for this specific use case </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Route issues">
				<xs:annotation>
					<xs:documentation>Route checked by 3rd party and the comments are available in routeWaypointLegIssue and/or routeInfoDescription attributes</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Service started">
				<xs:annotation>
					<xs:documentation>This status is used for routes sent to a ship confirming a shore based service has started for the given route </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Service ended">
				<xs:annotation>
					<xs:documentation>This status is used for routes sent to a ship confirming a shore based service has been ended for the given route.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="typeOfShipType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="General Cargo Vessel">
				<xs:annotation>
					<xs:documentation>A vessel which is designed for carrying general cargo, e.g. boxes, sacks.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Container Vessel">
				<xs:annotation>
					<xs:documentation>A vessel which is designed for carrying containers.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Tanker">
				<xs:annotation>
					<xs:documentation>A vessel which is designed for carrying liquid goods, for example oil or water.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Sailing Vessel">
				<xs:annotation>
					<xs:documentation>A vessel that is powered by the wind; often having several masts.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Fishing Vessel">
				<xs:annotation>
					<xs:documentation>	A vessel that is used and equipped for the fishing of living aquatic resources.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Special Purpose Vessel">
				<xs:annotation>
					<xs:documentation>A vessel that fulfills special purposes; for example hovercrafts, pilot boats.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Man of War">
				<xs:annotation>
					<xs:documentation>Armed naval vessel.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Submarine">
				<xs:annotation>
					<xs:documentation>A vessel that is capable of operating for an extended period of time underwater.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="High Speed Craft">
				<xs:annotation>
					<xs:documentation>A motorized vessel capable of reaching speeds over 40km/h with respect to water.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Bulk Carrier">
				<xs:annotation>
					<xs:documentation>A vessel which is designed for carrying bulk goods, e.g. coal, ore or grain.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Seaplane">
				<xs:annotation>
					<xs:documentation>	Airplane designed to take off from and alight on water.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Tugboat">
				<xs:annotation>
					<xs:documentation>A powerful small boat designed to pull or push larger ships or powerless barges.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Passenger Vessel">
				<xs:annotation>
					<xs:documentation>A day trip or cabin vessel constructed and equipped to carry more than 12 passengers.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Ferry">
				<xs:annotation>
					<xs:documentation>A vessel for transporting passengers, vehicles, and/or goods across a stretch of water, especially as a regular service.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Boat">
				<xs:annotation>
					<xs:documentation>A small vessel.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="routeWaypointLegGeometryTypeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="loxodrome (= rhumb line)">
				<xs:annotation>
					<xs:documentation>loxodrome</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="orthodrome (= great circle)">
				<xs:annotation>
					<xs:documentation>orthodrome</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="routeActionPointRequiredActionType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="UserDefined">
				<xs:annotation>
					<xs:documentation>UserDefined</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Report">
				<xs:annotation>
					<xs:documentation>Report</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UKCM">
				<xs:annotation>
					<xs:documentation>UKCM</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Note">
				<xs:annotation>
					<xs:documentation>Note</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Critical point">
				<xs:annotation>
					<xs:documentation>Critical point</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Others">
				<xs:annotation>
					<xs:documentation>Others</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
