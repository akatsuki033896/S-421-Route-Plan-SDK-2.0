	<!-- ========================================================================================== -->
	<!-- types and elements for the information types definition                                    -->
	<!-- ========================================================================================== -->
	<xs:element name="InformationType" type="InformationTypeType" abstract="true"/>
	<xs:complexType name="InformationTypeType" abstract="true">
		<xs:annotation>
			<xs:documentation>Generalized information type which carry all the common attributes</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="S100:AbstractInformationType"/>
		</xs:complexContent>
	</xs:complexType>
	<xs:element name="RouteInfo" type="RouteInfoType"/>
	<xs:complexType name="RouteInfoType">
		<xs:annotation>
			<xs:documentation/>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="InformationTypeType">
				<xs:sequence>
					<xs:element name="routeInfoName" type="xs:string" minOccurs="1" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Name of the route</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoAuthor" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Author of the route</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoEditionTime" type="xs:dateTime" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Time this edition of route plan is edited</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoDescription" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Additional information for the status of the route</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoStatus" type="routeInfoStatusType" minOccurs="1" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Enumerated status value of the route</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoMasterApproval" type="xs:boolean" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Confirmation the route plan has been approved by the master of the ship</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoValidityStart" type="xs:dateTime" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Start of validity of route plan</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoValidityEnd" type="xs:dateTime" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>End of validity of route plan</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoDeparturePortID1" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Primary identifier for departure port given by UN/LOCODE</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoDeparturePortID2" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Secondary identifier for departure port given by free text</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoDeparturePortCall" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Reference to port call identifier in departing port</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoArrivalPortID1" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Primary identifier for arrival port given by UN/LOCODE</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoArrivalPortID2" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Secondary identifier for arrival port given by free text</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoArrivalPortCall" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Reference to port call identifier in arriving port</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoReferencePrevRoute" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Reference previous route</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoReferenceNextRoute" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Reference next route</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="typeOfShip" type="typeOfShipType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Type of ship</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoVesselName" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Ship's name</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoVesselMMSI" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Ship's MMSI</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoVesselCallsign" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Ship's call sign</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoVesselIMO" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Ship's IMO number</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoVesselVoyage" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Unique voyage identifier</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoVesselHeight" type="xs:double" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Vessel height measured from the keel to the masthead</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoVesselLength" type="xs:double" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Vessel length overall (LOA)</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoVesselBeam" type="xs:double" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Vessel beam</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoDraftMax" type="xs:double" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Maximum vessel draft</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoAirDraftMax" type="xs:double" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Maximum vessel air draft</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="routeInfoBeamMax" type="xs:double" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Maximum vessel beam</xs:documentation>
