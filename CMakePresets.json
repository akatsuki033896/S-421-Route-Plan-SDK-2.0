{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "sdk",
      "displayName": "s421 SDK",
      "description": "build s421.lib / s421.a",
      "inherits": "base",
      "cacheVariables": {
        "S421_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "demo",
      "displayName": "s421 SDK with examples",
      "description": "build s421 libs and example programs",
      "inherits": "base",
      "cacheVariables": {
        "S421_BUILD_EXAMPLES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "sdk",
      "configurePreset": "sdk"
    },
    {
      "name": "demo",
      "configurePreset": "demo"
    }
  ]
}